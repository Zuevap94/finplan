# Database
DATABASE_URL=sqlite:///./finplan.db
# For PostgreSQL:
# DATABASE_URL=postgresql://finplan:password@localhost:5432/finplan

# Security
SECRET_KEY=change-me-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Email (optional)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@finplan.ru

# Tax rates
NDFL_RATE=0.13
NDFL_RATE_HIGH=0.15
NDFL_HIGH_THRESHOLD=5000000
DIVIDEND_TAX_RATE=0.13
